# ==============================================================================
# ValorIO — Configuration des Variables d'Environnement (.env.example)
# ==============================================================================
# Copiez ce fichier vers un fichier .env local ou configurez vos variables dans
# votre environnement d'exécution (PowerShell / Bash / Docker / CI-CD).
# Ne committez JAMAIS de secrets réels dans le dépôt Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=valorio
DB_USER=postgres
DB_PASS=bilel

# ------------------------------------------------------------------------------
# 2. Sécurité & Authentification JWT
# ------------------------------------------------------------------------------
# Clé secrète cryptographique utilisée pour signer les jetons HMAC-SHA256 (32 caractères minimum)
JWT_SECRET=valorio-super-secret-jwt-signing-key-minimum-32-chars!

# Durée de validité du jeton d'accès en minutes (recommandé: 15 minutes)
JWT_EXPIRATION_MINUTES=15

# Durée de validité de la session de rafraîchissement (refresh token) en jours
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Attributs des cookies HTTP-Only pour le rafraîchissement
# false en développement HTTP local, true impérativement en production HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ------------------------------------------------------------------------------
# 3. Frontend Angular
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:4200

# ------------------------------------------------------------------------------
# 4. Intelligence Artificielle & Fournisseurs LLM
# ------------------------------------------------------------------------------
# Fournisseur actif : 'mock' (aucun identifiant requis) ou 'openai' (compatible OpenAI / DeepSeek / Ollama / Groq)
AI_PROVIDER=mock

# Clé d'API du fournisseur d'IA (laisser vide si AI_PROVIDER=mock)
AI_API_KEY=

# Modèle utilisé (ex. gpt-4o-mini, gpt-4o, claude-3-5-sonnet, deepseek-coder)
AI_MODEL=gpt-4o-mini

# URL de base de l'API LLM (pour OpenAI: https://api.openai.com/v1, ou Ollama: http://localhost:11434/v1)
AI_BASE_URL=https://api.openai.com/v1

# Délai d'expiration des requêtes LLM en millisecondes
AI_REQUEST_TIMEOUT=15000

# ------------------------------------------------------------------------------
# 5. Service d'Envoi d'Emails (SMTP Optionnel)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@valorio.tn

# ------------------------------------------------------------------------------
# 6. Collaboration inter-services (URLs des microservices)
# ------------------------------------------------------------------------------
AUTH_URL=http://localhost:8084
OBJETS_URL=http://localhost:8085

# Module Recommandation : moteur d'inference IA (Python FastAPI) et marketplace
VALORIO_ML_BASE_URL=http://localhost:8090
VALORIO_MARKETPLACE_BASE_URL=http://localhost:8086
# Fournisseur d'explication IA du service-recommandation : 'mock' (hors-ligne) ou 'openai'
VALORIO_AI_PROVIDER=mock
