/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "paths": {
      "@valorio/shared": [
        "./projects/shared/src/public-api.ts"
      ],
      "@valorio/api-reparation": [
        "./projects/api-reparation/src/public-api.ts"
      ],
      "@valorio/api-don": [
        "./projects/api-don/src/public-api.ts"
      ],
      "@valorio/api-recyclage": [
        "./projects/api-recyclage/src/public-api.ts"
      ],
      "@valorio/feature-reparation": [
        "./projects/feature-reparation/src/public-api.ts"
      ],
      "@valorio/feature-don": [
        "./projects/feature-don/src/public-api.ts"
      ],
      "@valorio/feature-recyclage": [
        "./projects/feature-recyclage/src/public-api.ts"
      ]
    },
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/shared/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared/tsconfig.spec.json"
    },
    {
      "path": "./projects/api-reparation/tsconfig.lib.json"
    },
    {
      "path": "./projects/api-reparation/tsconfig.spec.json"
    },
    {
      "path": "./projects/api-don/tsconfig.lib.json"
    },
    {
      "path": "./projects/api-don/tsconfig.spec.json"
    },
    {
      "path": "./projects/api-recyclage/tsconfig.lib.json"
    },
    {
      "path": "./projects/api-recyclage/tsconfig.spec.json"
    },
    {
      "path": "./projects/feature-reparation/tsconfig.lib.json"
    },
    {
      "path": "./projects/feature-reparation/tsconfig.spec.json"
    },
    {
      "path": "./projects/feature-don/tsconfig.lib.json"
    },
    {
      "path": "./projects/feature-don/tsconfig.spec.json"
    },
    {
      "path": "./projects/feature-recyclage/tsconfig.lib.json"
    },
    {
      "path": "./projects/feature-recyclage/tsconfig.spec.json"
    }
  ]
}
